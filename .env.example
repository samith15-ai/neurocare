# NeuroCare Environment Variables

# App Environment
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=neurocare_dev_insecure_secret_key_change_in_production_min32chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","capacitor://localhost","http://localhost"]

# Database Configuration
# In local development, defaults to SQLite if POSTGRES_URL is not supplied.
USE_SQLITE=True
SQLITE_DB_PATH=./neurocare_dev.db
DATABASE_URL=sqlite:///./neurocare_dev.db
# PostgreSQL for production / Docker:
# DATABASE_URL=postgresql://neurocare_user:neurocare_password@localhost:5432/neurocare_db

# Clinical Threshold Configuration
CLINICAL_CONFIG_PATH=../config/clinical_thresholds.json
SCORING_RULES_PATH=../config/scoring_rules.json

# Emergency FAST Alert Helpline
EMERGENCY_HELPLINE=911
EMERGENCY_ADVISORY_MESSAGE="IMMEDIATE EMERGENCY ATTENTION REQUIRED: Observed acute facial drooping, limb weakness, or speech impairment triggers the FAST protocol. Seek emergency medical care immediately."
