  "pattern_rules": [
    {
      "rule_id": "RULE_SLOWNESS_REDUCED_AMPLITUDE",
      "domains": ["motor"],
      "title": "Slowness with reduced movement amplitude",
      "requires_multimodal": false,
      "explanation": "Observed simultaneous reduction in finger-tapping cadence and peak opening amplitude compared to reference norm.",
      "criteria": [
        { "feature": "right_finger_tap_frequency_hz", "op": "z_lte", "threshold": -1.5 },
        { "feature": "right_finger_tap_mean_amplitude", "op": "z_lte", "threshold": -1.5 }
      ]
    },
    {
      "rule_id": "RULE_LEFT_RIGHT_ASYMMETRY",
      "domains": ["motor", "facial"],
      "title": "Observed left-right movement asymmetry",
      "requires_multimodal": false,
      "explanation": "Bilateral comparison indicates noticeable asymmetry between right and left performance (> 20% motor difference or < 82% smile symmetry).",
      "criteria": [
        { "feature": "bilateral_tap_frequency_asymmetry", "op": "val_gte", "threshold": 0.20 },
        { "feature": "smile_symmetry_ratio", "op": "val_lte", "threshold": 0.82 }
      ],
      "operator": "OR"
    },
    {
      "rule_id": "RULE_IRREGULAR_MOTOR_RHYTHM",
      "domains": ["motor"],
      "title": "Irregular motor rhythm and hesitations",
      "requires_multimodal": false,
      "explanation": "Inter-tap interval variance indicates cadence irregularity or intermittent movement hesitation.",
      "criteria": [
        { "feature": "right_finger_tap_iti_cv", "op": "z_gte", "threshold": 1.8 }
      ]
    },
    {
      "rule_id": "RULE_COORDINATION_MULTIMODAL",
      "domains": ["motor", "speech"],
      "title": "Multimodal behavioral coordination changes",
      "requires_multimodal": true,
      "explanation": "Evidence from both motor tapping rhythm and rapid speech articulation ('pa-ta-ka') shows concurrent coordination variability.",
      "criteria": [
        { "feature": "right_finger_tap_iti_cv", "op": "z_gte", "threshold": 1.5, "domain": "motor" },
        { "feature": "ddk_regularity_cv", "op": "z_gte", "threshold": 1.5, "domain": "speech" }
      ],
      "operator": "AND"
    },
    {
      "rule_id": "RULE_POSTURAL_INSTABILITY_SWAY",
      "domains": ["balance"],
      "title": "Postural instability during quiet stance",
      "requires_multimodal": false,
      "explanation": "Postural sway analysis indicates elevated center-of-mass excursion path or sway area during quiet stance.",
      "criteria": [
        { "feature": "balance_sway_path_norm", "op": "z_gte", "threshold": 1.8 }
      ]
    },
    {
      "rule_id": "RULE_GAIT_ASYMMETRY_REDUCED_ARM_SWING",
      "domains": ["gait"],
      "title": "Gait asymmetry with unilateral arm swing reduction",
      "requires_multimodal": false,
      "explanation": "Ambulation analysis demonstrates step temporal asymmetry (> 1.6 SD below norm) coupled with prominent arm-swing asymmetry.",
      "criteria": [
        { "feature": "gait_step_symmetry_ratio", "op": "z_lte", "threshold": -1.6 },
        { "feature": "gait_arm_swing_asymmetry", "op": "z_gte", "threshold": 1.8 }
      ],
      "operator": "AND"
    },
    {
      "rule_id": "RULE_COGNITIVE_PSYCHOMOTOR_SLOWNESS",
      "domains": ["cognition"],
      "title": "Psychomotor processing slowness with attention variability",
      "requires_multimodal": false,
      "explanation": "Cognitive performance demonstrates reaction time prolongation alongside reduced sequence span.",
      "criteria": [
        { "feature": "cognitive_simple_reaction_time_ms", "op": "z_gte", "threshold": 1.8 },
        { "feature": "cognitive_sequence_span_length", "op": "z_lte", "threshold": -1.5 }
      ],
      "operator": "AND"
    }
  ]
}
